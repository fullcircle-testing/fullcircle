{
  "name": "fullcircle-root",
  "version": "1.0.0",
  "description": "",
  "main": "dist/harness.js",
  "scripts": {
    "start": "npm run recorder",
    "recorder": "DATA_LOG_OUT_DIR=\"$PWD/data_logs\" npm start --prefix packages/recorder --",
    "build": "tsup --entry.harness packages/harness/src/index.ts --entry.recorder packages/recorder/src/index.ts --entry.vite-plugin packages/recorder/src/vite_plugin.ts --format esm,cjs --dts",
    "prepare": "npm run build",
    "test": "jest --runInBand && npm test --prefix example_app/server",
    "check-types": "npm run check-types --prefix packages/harness && npm run check-types --prefix packages/recorder && npm run tsc --prefix example_app/server && npm run check-types --prefix example_app/tests-e2e",
    "test:smoke:real-providers": "jest packages/harness/tests/providers/real_provider_smoke.test.ts --runInBand"
  },
  "bin": {
    "fc-record": "./dist/recorder.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/express-http-proxy": "^1.6.6",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.2",
    "@types/node-fetch": "^2.6.9",
    "better-sqlite3": "^12.10.0",
    "jest": "^29.7.0",
    "jest-mock-server": "^0.1.0",
    "node-fetch": "^2.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsup": "^8.0.1",
    "typescript": "^5.2.2"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  }
}
