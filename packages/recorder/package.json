{
  "name": "@fullcircle/recorder",
  "version": "1.0.0",
  "description": "FullCircle recorder package",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./vite-plugin": {
      "types": "./dist/vite_plugin.d.ts",
      "import": "./dist/vite_plugin.mjs",
      "require": "./dist/vite_plugin.js"
    }
  },
  "bin": {
    "fc-record": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/vite_plugin.ts --format cjs,esm --dts --out-dir dist && tsup src/cli.ts --format cjs --dts --out-dir dist && node ../../scripts/ensure-cli-executable.cjs dist/cli.js",
    "start": "ts-node src/cli.ts",
    "dev": "ts-node-dev src/cli.ts",
    "test": "jest && npm test --prefix example_app/server",
    "check-types": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "commander": "^11.1.0"
  }
}
